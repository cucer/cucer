*.tsbuildinfo
.eslintcache

# Tool logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dependencies
node_modules/

# Build / cache folders for other static tooling
dist/
build/
.cache/
.parcel-cache/
