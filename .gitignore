# macOS user files
.DS_Store
.AppleDouble
.LSOverride
Icon?

# macOS thumbnail caches
._*
.Spotlight-V100
.Trashes

# Editor swap/backup files
*.swp
*.swo
*~

# Editor / tooling folders
.vscode/
.idea/
.claude/

# Local environment overrides
.env
.env.*
*.local

# Client briefs, pricing notes and anything else that must not reach a public
# repo. Keep commercial material here, never under src/.
docs/

# Next.js build output and caches
.next/
out/
next-env.d.ts
.turbo/

# Incremental compiler / linter caches. Machine-local state, regenerated on
# every build — they only ever cause merge noise in a repo.
*.tsbuildinfo
.eslintcache

# Tool logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dependencies
node_modules/

# Build / cache folders for other static tooling
dist/
build/
.cache/
.parcel-cache/

# Client demo work. Lives on this machine only: it is someone else's brand and
# material, and it does not belong in my public repo. The files stay on disk,
# so `next dev` keeps serving /demos/* locally — git simply does not see them,
# which means the Actions runner clones a tree without them and the published
# site has no /demos/* at all. Putting the paths back is all it takes to have
# the demo again.
src/demos/
src/app/(demos)/
public/demos/
